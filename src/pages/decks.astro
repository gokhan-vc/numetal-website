---
import Base from '../layouts/Base.astro';
import { subscribeBlockCss, subscribeBlockHtml } from '../lib/subscribe-block';
import { docChromeCss, mastheadHtml, colophonHtml } from '../lib/doc-furniture';
export const prerender = true;
const title = "Numetal — decks";
const description = "Pitch decks and one-pagers for Numetal, an agentic acceleration lab and bureau under Gökhan Ventures, and its launched projects.";
const canonical = "https://numetal.xyz/decks";
const ogImage = "https://numetal.xyz/og.png";

// A deck entry: { nm, tag, file? (public path to a PDF), status }.
// To publish a deck: drop the PDF in /public/decks/ and set `file`; status auto-reads "PDF ↗".
// url = a live deck page; file = a PDF under /public/decks/; neither = request-only.
const decks = [
  { nm: 'Ishtar', tag: 'Agent-native courtship infrastructure', url: 'https://ishtar.numetal.xyz/deck/not-raising-a-preseed/' },
  { nm: 'CURB', tag: 'Agent↔agent inference swap', url: 'https://curb.numetal.xyz/deck' },
  { nm: 'Numetal — studio', tag: 'The lab & bureau, the thesis, the projects' },
  { nm: 'CLINAMEN', tag: 'A hyperstitional AI lab, built for real' },
];

const rows = decks.map((d) => {
  const link = d.url
    ? `<a class="dl" href="${d.url}" target="_blank" rel="noopener">View deck ↗</a>`
    : d.file
    ? `<a class="dl" href="${d.file}" target="_blank" rel="noopener">PDF ↗</a>`
    : `<a class="dl req" href="mailto:contact@gokhan.vc?subject=Deck%20request%20—%20${encodeURIComponent(d.nm)}">Request ↗</a>`;
  return `
      <div class="deck">
        <div class="drow"><span class="dn">${d.nm}</span>${link}</div>
        <span class="dt">${d.tag}</span>
      </div>`;
}).join('');

const bodyHtml = `<style>
  :root{--ikb:#002FA7;--ink:#141414;--mut:#7c7c7c;--hard:#8c8c8c;--line:#cdcdcd;--bgray:#e7e7e7;
    --mono:ui-monospace,'SF Mono','SFMono-Regular',Menlo,Consolas,monospace;--sans:'Helvetica Neue',Helvetica,Arial,'Liberation Sans',sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-font-smoothing:antialiased}
  body{background:var(--bgray);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5}
  a{color:var(--ikb);text-decoration:none}a:hover{text-decoration:underline}
  .sheet{max-width:760px;margin:0 auto;background:#fff;border-left:1px solid #c4c4c4;border-right:1px solid #c4c4c4;min-height:100vh;display:flex;flex-direction:column}
  .top{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 32px 14px;position:sticky;top:29px;z-index:190;background:#fff;border-bottom:1px solid var(--line)}
  .mark{display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:.03em;font-size:16px}.mark a{color:var(--ink)}.mark .sq{width:12px;height:12px;background:var(--ikb)}
  nav{display:flex;gap:17px;font-size:13px;align-items:center}nav a{color:var(--ink)}nav a.on{color:var(--ikb);font-weight:700}
  .stamp{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);padding:0 32px 14px}
  .dither{height:11px;background-image:radial-gradient(#191919 .62px,transparent .72px);background-size:3px 3px}
  main{flex:1}
  .head{padding:30px 32px 6px}
  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);margin-bottom:10px}
  h1{font-size:30px;line-height:1.05;font-weight:700;letter-spacing:-.02em}h1 .dot{color:var(--ikb)}
  .sub{font-size:14px;color:#555;margin-top:10px;max-width:60ch;line-height:1.55}
  .sec{padding:16px 32px 40px}
  .sh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:var(--mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:14px}.sh .ix0{color:var(--mut);font-weight:400;letter-spacing:.14em}
  .decks{border:2px solid var(--ink)}
  .deck{padding:15px 17px;border-bottom:1px solid var(--line)}.deck:last-child{border-bottom:0}
  .drow{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .dn{font-weight:700;font-size:16px}
  .dt{display:block;font-size:13px;color:#555;margin-top:3px}
  .dl{font-family:var(--mono);font-size:12px;letter-spacing:.04em;border:1.5px solid var(--ink);padding:4px 10px;white-space:nowrap;box-shadow:2px 2px 0 rgba(0,0,0,.4)}
  .dl:hover{background:var(--ikb);color:#fff;text-decoration:none}
  .dl.req{border-color:var(--hard);color:var(--mut);box-shadow:none}.dl.req:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
  .note{font-size:13.5px;color:#444;margin-top:16px;max-width:70ch;line-height:1.6}
  .ways{font-family:var(--mono);font-size:12px;letter-spacing:.03em;color:var(--mut);margin-top:8px}.ways a{color:var(--ikb)}
  .ft{border-top:1px solid var(--ink);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-family:var(--mono);font-size:11px;color:var(--mut);padding:18px 32px}.ft a{color:var(--mut)}.flinks{display:flex;gap:13px;flex-wrap:wrap;justify-content:flex-end}
  @media(max-width:740px){.top,.stamp,.head,.sec,.ft{padding-left:18px;padding-right:18px}nav{display:none}h1{font-size:25px}}
  ${docChromeCss}
  ${subscribeBlockCss}
  @media (prefers-color-scheme:dark){.sub{color:#a6a6a3}.dt,.note{color:#b4b4b1}}
</style>

<div class="sheet">
  <div class="top">
    <div class="mark"><span class="sq"></span><a href="/">NUMETAL</a></div>
    <nav>
      <a href="/#projects">Projects</a>
      <a href="/decks" class="on">Decks</a>
      <a href="/blog">Blog</a>
      <a href="https://gokhan.vc" target="_blank" rel="noopener">Gökhan&nbsp;Ventures&nbsp;↗</a>
    </nav>
  </div>
  <div class="stamp">Doc · <b>Decks</b> · the studio &amp; its projects</div>
  <div class="dither"></div>

  <main>
    ${mastheadHtml({
      docNo: 'NML-020',
      status: 'Status: open file',
      titleHtml: '<h1>Decks<span class="dot">.</span></h1><p class="sub">Pitch decks and one-pagers for the lab and its launched projects. Filed here as they are prepared.</p>',
      sub: 'Numetal · decks register',
      stamp: 'Decks',
      footLeft: 'numetal.xyz/decks',
      footRight: 'studio & projects',
    })}

    <section class="sec">
      <div class="sh"><span>The decks</span><span class="ix0">§01</span></div>
      <div class="decks">${rows}
      </div>
      <p class="note">Decks are filed here as they are finalized — a PDF appears in place of <b>Request</b> the moment one ships. In the meantime, request any deck and it comes straight back. For the projects themselves, see the <a href="/#projects">projects index</a>.</p>
      <p class="ways">Request → <a href="mailto:contact@gokhan.vc">contact@gokhan.vc</a> · or reach the studio on <a href="https://t.me/numetalxyz" target="_blank" rel="noopener">Telegram</a> / <a href="https://x.com/numetalxyz" target="_blank" rel="noopener">X</a></p>
    </section>
  </main>

  ${subscribeBlockHtml}
  <div class="dither"></div>
  <footer class="ft">
    <span>Numetal · a Gökhan Ventures lab &amp; bureau · on Base</span>
    <span class="flinks">
      <a href="/">Studio</a>
      <a href="/#projects">Projects</a>
      <a href="https://gokhan.vc" target="_blank" rel="noopener">Gökhan Ventures</a>
      <a href="/blog">Blog</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
    </span>
  </footer>
  ${colophonHtml({ docNo: 'NML-020', note: 'Decks filed as prepared' })}
</div>
`;
---
<Base title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <Fragment set:html={bodyHtml} />
</Base>

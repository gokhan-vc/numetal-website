---
import Base from '../layouts/Base.astro';
import { subscribeBlockCss, subscribeBlockHtml } from '../lib/subscribe-block';
import { docChromeCss, mastheadHtml, colophonHtml } from '../lib/doc-furniture';
export const prerender = true;
const title = "Numetal — agentic acceleration lab & bureau";
const description = "Numetal is an agentic acceleration lab and bureau under Gökhan Ventures. We build, ship, and back autonomous agents across onchain, compute, culture, and frontier-lab tooling. Live products: Ishtar, CURB, CLINAMEN, Reclaim, plaintext, Accumulator — plus HeartBench, The Window, the Bureau Reader, CCRU archive, and tickerline.";
const canonical = "https://numetal.xyz/";
const ogImage = "https://numetal.xyz/og.png";
const jsonLd = `{"@context":"https://schema.org","@graph":[
{"@type":"Organization","@id":"https://numetal.xyz/#organization","name":"Numetal","alternateName":"$NUMETAL","url":"https://numetal.xyz/","description":"Numetal is an agentic acceleration lab and bureau under Gökhan Ventures, building and backing autonomous agents across onchain, compute, culture, and frontier-lab tooling.","slogan":"We ship machines that ship themselves.","parentOrganization":{"@type":"Organization","name":"Gökhan Ventures","url":"https://gokhan.vc"},"founder":{"@type":"Person","name":"Gökhan Turhan","url":"https://gokhanturhan.com"},"sameAs":["https://gokhan.vc","https://github.com/gokhan-vc","https://gokhanturhan.com"]},
{"@type":"WebSite","@id":"https://numetal.xyz/#website","url":"https://numetal.xyz/","name":"Numetal","publisher":{"@id":"https://numetal.xyz/#organization"}}
]}`;

// Flagship products, weighted. Six cells at identical weight said the studio has no
// opinion about its own catalogue: Ishtar carries a paid API (402 on /api/chat/ask),
// an MCP + skill endpoint, a leaderboard and a paid board; three of the six are a page
// and a promise. `tier` sets the cell's width and its type size — 1 leads the row,
// 2 takes half of the second row, 3 takes a third of the third. Nothing is dropped;
// the catalogue is ranked instead of listed.
// Editorial pass (spec 1.11). Six blurbs all built as "NOUN PHRASE — gloss" is the same
// sentence six times with the nouns swapped, and a reader clocks the shape before the
// words. Every fact survives; the six now break differently — a full stop, a colon, a
// relative clause. Nothing here is a new claim.
const products = [
  { nm: 'Ishtar', heart: true, tier: 1, url: 'https://ishtar.numetal.xyz', host: 'ishtar.numetal.xyz',
    one: 'Agentic dating. Your agent does the courting; you show up once both sides have agreed.',
    surf: 'HeartBench · The Window · MCP + skill endpoints · a paid x402 API' },
  { nm: 'CURB', tier: 2, url: 'https://curb.numetal.xyz', host: 'curb.numetal.xyz',
    one: 'Agent↔agent inference swap: agents buy and sell inference over dual-payee x402.' },
  { nm: 'CLINAMEN', tier: 2, url: 'https://ubu.numetal.xyz', host: 'ubu.numetal.xyz',
    one: 'A hyperstitional AI lab, built for real. Models, a corpus, and a full reader.' },
  { nm: 'Reclaim', tier: 3, url: 'https://reclaim.numetal.xyz', host: 'reclaim.numetal.xyz',
    one: 'Non-custodial rescue for art stranded on dead NFT marketplaces: Foundation and Zora.' },
  { nm: 'plaintext', tier: 3, url: 'https://plaintext.numetal.xyz', host: 'plaintext.numetal.xyz',
    one: 'An onchain board where every post is an ERC-721 on Robinhood Chain, settled in USDG.' },
  { nm: 'Accumulator', tier: 3, url: 'https://accumulator.numetal.xyz', host: 'accumulator.numetal.xyz',
    one: 'Turns LLM inference-price volatility into onchain yield: a token reservoir for machine intelligence.' },
];

// Taxonomy — what lives under each product / where it belongs.
const families = [
  { parent: 'Ishtar', purl: 'https://ishtar.numetal.xyz', tag: 'the dating family', items: [
    { nm: 'HeartBench', tag: 'model-dating leaderboard', url: 'https://ishtar.numetal.xyz/heartbench' },
    { nm: 'The Window', tag: 'the paid board, 24h / 10 slots', url: 'https://ishtar.numetal.xyz/window' },
    { nm: 'HeartPrefs', tag: 'the preference engine', url: 'https://ishtar.numetal.xyz' },
  ]},
  { parent: 'CLINAMEN', purl: 'https://ubu.numetal.xyz', tag: 'the Bureau', items: [
    { nm: 'The Bureau Reader', tag: 'the full training corpus', url: 'https://ubu.numetal.xyz/reader/' },
    { nm: 'CLINAMEN-Chat', tag: 'the conversational oracle', url: 'https://huggingface.co/spaces/gokhanturhan/CLINAMEN-Chat' },
    { nm: 'CCRU.net archive', tag: 'the CCRU, mirrored', url: 'https://ccru.numetal.xyz' },
  ]},
  { parent: 'Agent tools', purl: 'https://claudelines.com', tag: 'built on Claude Code', items: [
    { nm: 'tickerline', tag: 'terminal status-line ticker', url: 'https://claudelines.com' },
  ]},
];

const prodCards = products.map((p) => `
        <a class="prod prod--t${p.tier}${p.heart ? ' hn' : ''}" href="${p.url}" target="_blank" rel="noopener">
          <span class="use">Use →</span>
          <span class="pn">${p.nm}${p.heart ? ' <span class="hh">♥</span>' : ''}</span>
          <span class="one">${p.one}</span>${p.surf ? `
          <span class="surf">${p.surf}</span>` : ''}
          <span class="pu">${p.host} →</span>
        </a>`).join('');

const taxCols = families.map((f) => `
        <div class="fam">
          <a class="fp" href="${f.purl}" target="_blank" rel="noopener">${f.parent}</a>
          <span class="ft2">${f.tag}</span>
          ${f.items.map((i) => `<a class="fi" href="${i.url}" target="_blank" rel="noopener"><span class="fin">${i.nm}</span><span class="fit">${i.tag} →</span></a>`).join('')}
        </div>`).join('');

const bodyHtml = `<style>
  :root{--ikb:#002FA7;--ink:#141414;--orange:#FF5A1F;--cyan:#0791a6;--gold:#9a7d12;--green:#1a8a3c;--line:#cdcdcd;--hard:#8c8c8c;--mut:#7c7c7c;--bgray:#e7e7e7;
    --mono:ui-monospace,'SF Mono','SFMono-Regular',Menlo,Consolas,monospace;--sans:'Helvetica Neue',Helvetica,Arial,'Liberation Sans',sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
  body{background:var(--bgray);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5}
  a{color:var(--ikb);text-decoration:none}a:hover{text-decoration:underline}
  .sheet{max-width:880px;margin:0 auto;background:#fff;border-left:1px solid #c4c4c4;border-right:1px solid #c4c4c4;min-height:100vh;display:flex;flex-direction:column}
  .top{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 32px 14px;position:sticky;top:29px;z-index:190;background:#fff;border-bottom:1px solid var(--line)}
  .mark{display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:.03em;font-size:16px}
  .mark .sq{width:12px;height:12px;background:var(--ikb)}
  nav{display:flex;gap:17px;font-size:13px;align-items:center}nav a{color:var(--ink)}nav a.hot{color:#e10600;font-weight:700}
  .stamp{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);padding:0 32px 14px}
  .dither{height:11px;background-image:radial-gradient(#191919 .62px,transparent .72px);background-size:3px 3px}
  main{flex:1}
  .head{padding:34px 32px 8px}
  h1{font-size:37px;line-height:1.03;font-weight:700;letter-spacing:-.025em;max-width:20ch}
  h1 .dot{color:var(--ikb)}
  .lead{font-size:16px;color:#2b2b2b;margin-top:16px;max-width:60ch;line-height:1.55}
  .def{border-left:3px solid var(--ikb);padding:3px 0 3px 16px;margin:22px 0;font-style:italic;color:#262626;line-height:1.5;max-width:64ch}
  .def b{font-weight:700;font-style:italic;color:var(--ink)}
  .cta{display:flex;gap:13px;align-items:center;margin-top:22px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:8px;background:var(--ikb);color:#fff;border:1.5px solid var(--ink);font-weight:700;font-size:14px;padding:9px 16px;box-shadow:2px 2px 0 rgba(0,0,0,.5);transition:filter .1s,transform .05s,box-shadow .05s}
  .btn:hover{filter:brightness(1.1);text-decoration:none}.btn:active{transform:translate(2px,2px);box-shadow:0 0 0}
  .btn.gh{background:#fff;color:var(--ink)}
  .btn.app{background:#e10600;border-color:var(--ink)}.btn.app .bh{color:#fff}
  .sec{padding:26px 32px;scroll-margin-top:56px}
  .sh{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:var(--mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:16px}.sh .ix0{color:var(--mut);font-weight:400;letter-spacing:.14em;white-space:nowrap}
  /* § numbers are retrieval handles, so each one is the anchor for its own section. */
  .sh a.ix0:hover,.sh a.ix0:focus-visible{color:var(--ink);text-decoration:none}
  /* products — three tiers on a 6-column register: the lead takes the row, the second
     tier a half each, the third a third each. Six cells at one weight is a list; this
     is the catalogue with an opinion in it. */
  .prods{display:grid;grid-template-columns:repeat(6,1fr);border:2px solid var(--ink)}
  .prod{position:relative;display:block;padding:17px 17px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);color:inherit;text-decoration:none;transition:background .1s}
  .prod--t1{grid-column:span 6;padding:22px 20px 20px;border-right:0}
  .prod--t2{grid-column:span 3}
  .prod--t3{grid-column:span 2;border-bottom:0}
  .prod:nth-child(3),.prod:nth-child(6){border-right:0}
  .prod:hover{background:var(--bgray);text-decoration:none}
  .prod .use{display:inline-block;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:var(--ikb);padding:2px 8px;margin-bottom:10px}
  .prod.hn .use{background:#e10600}
  .prod .pn{font-weight:700;font-size:17px;letter-spacing:-.01em;display:block}.prod .pn .hh{color:#e10600}
  .prod--t1 .pn{font-size:28px;letter-spacing:-.02em}
  .prod--t2 .pn{font-size:20px}
  .prod .one{display:block;font-size:12.5px;color:#4a4a4a;line-height:1.45;margin-top:9px}
  .prod--t1 .one{font-size:15px;line-height:1.5;max-width:52ch}
  .prod--t2 .one{font-size:13px}
  .prod .surf{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-top:11px;border-top:1px solid var(--line);padding-top:9px}
  .prod .pu{font-family:var(--mono);font-size:11px;color:var(--mut);margin-top:10px;display:block}.prod:hover .pu{color:var(--ikb)}
  /* taxonomy — where the pieces belong */
  .tax{display:grid;grid-template-columns:repeat(3,1fr);border:2px solid var(--ink)}
  .fam{padding:15px 16px;border-right:1px solid var(--line)}.fam:last-child{border-right:0}
  .fam .fp{font-weight:700;font-size:15.5px;color:var(--ink)}.fam .fp:hover{color:var(--ikb)}
  .fam .ft2{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut);margin:2px 0 8px;display:block}
  .fam .fi{display:block;padding:8px 0;border-top:1px solid var(--line);text-decoration:none;color:inherit}
  .fam .fi:hover{color:var(--ikb)}
  .fam .fin{font-weight:600;font-size:13.5px;display:block}.fam .fit{font-family:var(--mono);font-size:11px;color:#6b6b6b}.fam .fi:hover .fit{color:var(--ikb)}
  .grid4{display:grid;grid-template-columns:repeat(2,1fr);border:2px solid var(--ink)}
  .cell{padding:18px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .cell:nth-child(2n){border-right:0}.cell:nth-last-child(-n+2){border-bottom:0}
  .cell .k{font-family:var(--mono);font-size:12px;letter-spacing:.04em;text-transform:uppercase;font-weight:700;margin-bottom:8px}
  .cell .k.o{color:var(--orange)}.cell .k.b{color:var(--ikb)}.cell .k.c{color:var(--cyan)}.cell .k.g{color:var(--gold)}
  .cell p{font-size:13.5px;color:#444;line-height:1.5}
  .note{font-size:13.5px;color:#444;margin-top:14px;max-width:74ch;line-height:1.55}
  .onchain{border:1px solid var(--line);background:#fafafa;padding:14px 16px}
  .onchain .oh{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);margin-bottom:9px}
  .onrow{display:flex;flex-wrap:wrap;gap:8px 16px;font-size:13px;align-items:baseline}
  .onrow .ol{font-family:var(--mono);font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em}
  .onrow a{font-family:var(--mono);font-size:12px}
  .onnote{font-size:12px;color:var(--mut);margin-top:9px;line-height:1.5;max-width:80ch}
  .ft{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-family:var(--mono);font-size:11px;color:var(--mut);padding:18px 32px}.ft a{color:var(--mut)}.flinks{display:flex;gap:13px;flex-wrap:wrap;justify-content:flex-end}
  .social{display:inline-flex;align-items:center;gap:14px}.social a{display:inline-flex;color:inherit;line-height:0;text-decoration:none}.social a:hover{color:var(--ikb)}.social svg{width:17px;height:17px;fill:currentColor;display:block}
  @media(max-width:740px){.top,.stamp,.head,.sec,.ft{padding-left:18px;padding-right:18px}.head{padding-top:26px}h1{font-size:28px}nav{display:none}.prods,.tax,.grid4{grid-template-columns:1fr}.prod--t1,.prod--t2,.prod--t3{grid-column:span 1}.prod,.cell{border-right:0}.prod,.prod:nth-last-child(-n+3),.cell:nth-last-child(-n+2){border-bottom:1px solid var(--line)}.prod:last-child,.cell:last-child{border-bottom:0}.prod--t1 .pn{font-size:24px}.prod--t1 .one{font-size:14px}.fam{border-right:0;border-bottom:1px solid var(--line)}.fam:last-child{border-bottom:0}}
  ${docChromeCss}
  .docmast{margin-bottom:0}
  .docmast-h{font-family:var(--mono);font-size:18px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.25}
  ${subscribeBlockCss}
  @media (prefers-color-scheme:dark){
    .lead{color:#d2d2cf}.def{color:#d6d6d3}
    /* .prod .tip was renamed .one and the dark override was never followed through, so
       every product blurb rendered #4a4a4a on a #181816 sheet. */
    .cell p,.note,.prod .one{color:#b4b4b1}.fam .fit{color:#9a9a97}
    .onchain{background:#1a1a18}.onnote,.onrow .ol{color:#9a9a97}
  }
</style>

<div class="sheet">
  <div class="top">
    <div class="mark"><span class="sq"></span>NUMETAL</div>
    <nav>
      <a href="#products">Products</a>
      <a href="/decks">Decks</a>
      <a class="hot" href="https://ishtar.numetal.xyz" target="_blank" rel="noopener">Ishtar&nbsp;♥</a>
      <a href="/blog">Blog</a>
      <a href="/newsletter">Newsletter</a>
      <a href="https://gokhan.vc" target="_blank" rel="noopener">Gökhan&nbsp;Ventures&nbsp;↗</a>
    </nav>
  </div>
  <div class="stamp">Doc · Studio · filed by <a href="https://gokhan.vc" target="_blank" rel="noopener">Gökhan Ventures</a></div>
  <div class="dither"></div>

  <main>
    ${/* Editorial pass (spec 1.11). Two edits here, both restatements rather than removals.
          · `Status: live` was the fifth liveness assertion in one viewport and the only
            masthead in the repo whose status field named the products' state instead of
            the document's. Every sibling page files a document status — "in force",
            "published", "open file", "not on file" — so this one does too. The liveness
            claim survives once, under the grid that evidences it (the .note below).
          · the sub-line repeated the h1 verbatim, three lines above the h1. A masthead
            sub-line's job is to say what is in the document; it now does that. */''}
    ${mastheadHtml({
      docNo: 'NML-001',
      status: 'Status: on file',
      titleHtml: '<div class="docmast-h">Numetal — studio dossier</div>',
      sub: 'Products · taxonomy · markets · treasury · a Gökhan Ventures filing',
      stamp: 'Studio record',
      footLeft: 'numetal.xyz',
      footRight: 'agents · bureau · on Base',
    })}
    <div class="head">
      <h1>An agentic acceleration lab &amp; bureau<span class="dot">.</span></h1>
      <p class="lead">Numetal builds, ships, and backs autonomous agents, then files the paperwork that makes them real. Six products below, each one you can use right now.</p>
      ${/* The definition block restated the h1 and then pre-empted §03's four markets, so
            it was the page's third and fourth restatement in a single paragraph. It now
            defines the one word on the page that nothing else explains. The claim is
            checkable on this site: NML-001 here, NML-002 /fees, NML-003 /airdrops,
            NML-020 /decks, each with a status line. */''}
      <div class="def"><b>Bureau</b> — why a studio files. This dossier, the fee report, the airdrop register and the decks each carry a document number and a status, and every one of them is public.</div>
      <div class="cta">
        <a class="btn" href="#products">Use the products ↓</a>
        <a class="btn app" href="https://ishtar.numetal.xyz" target="_blank" rel="noopener">Use Ishtar <span class="bh">♥</span></a>
        <a class="btn gh" href="/decks">Decks →</a>
      </div>
    </div>

    <div class="dither"></div>
    ${/* Editorial pass (spec 1.11). Four section heads all shaped "PHRASE — gloss", each
          gloss restating something the section itself says two lines later. The heads keep
          their position, their weight and their § anchors; they now carry the informative
          half only. The one surviving liveness assertion is the .note, which sits directly
          under the six cells that evidence it and now names all six rather than four. */''}
    <section class="sec" id="products"><div class="sh"><span>The products</span><a class="ix0" href="#products">§01</a></div>
      <div class="prods">${prodCards}
      </div>
      <p class="note">Six shipped and live: Ishtar (dating), CURB (inference swap), CLINAMEN (a hyperstitional AI lab), Reclaim (NFT rescue), plaintext (an onchain board) and Accumulator (a yield reservoir). More in the queue; see the <a href="/decks">decks</a>.</p>
    </section>

    <div class="dither"></div>
    <section class="sec" id="inside"><div class="sh"><span>Where the pieces belong</span><a class="ix0" href="#inside">§02</a></div>
      <div class="tax">${taxCols}
      </div>
    </section>

    <div class="dither"></div>
    <section class="sec" id="markets"><div class="sh"><span>Agents across four markets</span><a class="ix0" href="#markets">§03</a></div>
      <div class="grid4">
        <div class="cell"><div class="k o">Onchain</div><p>Agents that live in the onchain economy: intelligence, trading, NFT rescue, and x402 services across the Base / Bankr agent economy.</p></div>
        <div class="cell"><div class="k b">Compute</div><p>Agents that buy and sell compute and inference, paying for what they consume and charging for what they serve, machine-to-machine over x402.</p></div>
        <div class="cell"><div class="k g">Culture &amp; hyperstition</div><p>Agents working in art, culture, and hyperstition: generative, speculative, accelerationist. Markets where taste and myth compound, not just liquidity.</p></div>
        <div class="cell"><div class="k c">Frontier-lab toolkits</div><p>Runtimes, skills, and harnesses built on frontier models. The tooling that turns raw models into autonomous operators that earn.</p></div>
      </div>
    </section>

    <div class="dither"></div>
    <section class="sec" id="treasury"><div class="sh"><span>Treasury &amp; onchain</span><a class="ix0" href="#treasury">§04</a></div>
      <div class="onchain">
        <div class="oh">Onchain footnote · home on Base</div>
        <div class="onrow">
          <span class="ol">Token</span><a href="https://dexscreener.com/base/0xf0ba727d596861455b31d6e444ed3ee41c77709a27f7d787ccf609f6c34dbbd8" target="_blank" rel="noopener">$NUMETAL · Base ↗</a>
          <span class="ol">Rails</span><span>Base x402 · Solana x402 · Tempo MPP · <span style="color:var(--hard)">XRP soon</span></span>
          <span class="ol">Fees</span><a href="/fees">fee engine →</a>
          <span class="ol">Airdrops</span><a href="/airdrops">/airdrops →</a>
        </div>
        <p class="onnote">$NUMETAL, the treasury, and x402 settlement live on Base; Ishtar services are also reachable over Solana x402 and Tempo MPP. Creator-fee claims split to team / treasury / burn onchain, and the <a href="/fees">fee-engine report</a> itemises the split. Not investment advice; see the <a href="/terms">terms</a>.</p>
      </div>
    </section>

  </main>

  ${subscribeBlockHtml}
  <div class="dither"></div>
